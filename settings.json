{
  "$comment": "Bharat's Claude Code setup. MERGE this into your user-global ~/.claude/settings.json so it applies in every directory. extraKnownMarketplaces makes marketplaces installable; enabledPlugins turns them on everywhere. ecc + superpowers are registered but intentionally NOT enabled here — they are one '/plugin install' away (see README cheatsheet).",
  "extraKnownMarketplaces": {
    "bharats-claude-toolkit-dev": {
      "source": { "source": "github", "repo": "bharatnain/bharats-claude-toolkit" }
    },
    "ui-ux-pro-max-skill": {
      "source": { "source": "github", "repo": "nextlevelbuilder/ui-ux-pro-max-skill" }
    },
    "addy-web-quality-skills": {
      "source": { "source": "github", "repo": "addyosmani/web-quality-skills" }
    },
    "ecc": {
      "source": { "source": "github", "repo": "affaan-m/ecc" }
    },
    "superpowers-marketplace": {
      "source": { "source": "github", "repo": "obra/superpowers-marketplace" }
    },
    "pm-skills": {
      "source": { "source": "github", "repo": "phuryn/pm-skills" }
    },
    "claude-code-workflows": {
      "source": { "source": "github", "repo": "wshobson/agents" }
    }
  },
  "enabledPlugins": {
    "bharats-claude-toolkit@bharats-claude-toolkit-dev": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "web-quality-skills@addy-web-quality-skills": true,
    "frontend-design@claude-plugins-official": true,
    "pm-product-discovery@pm-skills": true,
    "pm-product-strategy@pm-skills": true,
    "pm-execution@pm-skills": true,
    "agent-teams@claude-code-workflows": true,
    "agent-orchestration@claude-code-workflows": true,
    "cloud-infrastructure@claude-code-workflows": true,
    "kubernetes-operations@claude-code-workflows": true,
    "cicd-automation@claude-code-workflows": true,
    "deployment-strategies@claude-code-workflows": true,
    "deployment-validation@claude-code-workflows": true,
    "observability-monitoring@claude-code-workflows": true,
    "incident-response@claude-code-workflows": true,
    "backend-development@claude-code-workflows": true,
    "backend-api-security@claude-code-workflows": true,
    "data-engineering@claude-code-workflows": true,
    "machine-learning-ops@claude-code-workflows": true
  },
  "permissions": {
    "allow": [
      "Bash(bash scripts/db-probe.sh:*)"
    ]
  }
}
